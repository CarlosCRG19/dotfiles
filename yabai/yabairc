# load scripting addition
yabai -m signal --add event=dock_did_restart action="sudo yabai --load-sa"
sudo yabai --load-sa # after each update of yabai this command will fail as the <hash> needs to be updated in /private/etc/sudoers.d/yabai. For reference, look at: https://github.com/koekeishiya/yabai/wiki/Installing-yabai-(latest-release)#configure-scripting-addition

# global settings
yabai -m config                              \
    layout                      bsp          \
    window_placement            second_child \
    auto_balance                off          \
    split_ratio                 0.5          \
    top_padding                 10           \
    left_padding                10           \
    right_padding               10           \
    bottom_padding              10           \
    window_gap                  10           \
    focus_follows_mouse         autoraise

# ignore
yabai -m rule --add app="^System Settings$" manage=off
# yabai -m rule --add app="^Raycast$" manage=off
